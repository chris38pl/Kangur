# =============================================================================
# Kangur Backend (.env.example)
# Copy to .env.local (local) or set in Vercel Project → Settings → Environment
# Variables. Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# App / URLs
# -----------------------------------------------------------------------------
# Canonical public URL of this API (no trailing slash).
# Local:  http://localhost:3000
# Prod:   https://api.getkangur.com  (or your Vercel production URL)
# Used for Stripe webhooks, absolute API links, etc. - not the marketing apex.
APP_URL=

# Same value exposed to the Next.js client bundle when needed (webhooks UI, etc.)
NEXT_PUBLIC_APP_URL=

# Marketing apex (landing + legal). No trailing slash.
# Local:  http://localhost:3000
# Prod:   https://getkangur.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Play listing (home CTA). Swap at launch without layout changes.
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.getkangur.mobile

# -----------------------------------------------------------------------------
# Mobile app version policy (public GET /api/v1/app/version)
# Bump on release so soft-update sheet appears without rebuilding the app.
# Plain semver only (1.2.3) — no pre-release tags.
# APP_PUBLISHED_AT: ISO-8601; unset → 1970-01-01T00:00:00.000Z (set on each bump).
# -----------------------------------------------------------------------------
APP_LATEST_VERSION=1.0.2
APP_MIN_SUPPORTED_VERSION=1.0.0
# APP_PUBLISHED_AT=2026-07-26T16:54:00.000Z


# Public inboxes (forward to your team mailbox). Domain: getkangur.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@getkangur.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@getkangur.com

# Optional: explicit API base if it differs from APP_URL (usually leave empty)
# NEXT_PUBLIC_API_URL=

# Comma-separated. Required for Expo web / browser clients.
# Local default (when unset in development): http://localhost:8081,http://127.0.0.1:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# -----------------------------------------------------------------------------
# Vercel (usually auto-injected - do not set manually in Vercel UI)
# Documented here so local tooling / scripts know they exist in deployed envs.
# https://vercel.com/docs/environment-variables/system-environment-variables
# -----------------------------------------------------------------------------
# VERCEL=1
# VERCEL_ENV=development|preview|production
# VERCEL_URL=                    # host without protocol, e.g. kangur-xxx.vercel.app
# VERCEL_PROJECT_PRODUCTION_URL= # production hostname
# VERCEL_GIT_COMMIT_SHA=
# VERCEL_GIT_COMMIT_REF=

# Optional: protect cron / internal routes if you add Vercel Cron later
# CRON_SECRET=

# -----------------------------------------------------------------------------
# Neon (Postgres) + Prisma
# Prefer Neon → Vercel integration to sync DATABASE_URL per environment.
# Use pooled connection for the app; direct for Prisma migrate.
# Do NOT use Prisma Accelerate on MVP.
# -----------------------------------------------------------------------------
# Pooled (runtime / serverless), e.g. ...-pooler.region.aws.neon.tech
DATABASE_URL=

# Direct (migrations / prisma migrate deploy), e.g. ...region.aws.neon.tech
DIRECT_URL=

# -----------------------------------------------------------------------------
# Clerk (email/password + Google + Apple)
# https://dashboard.clerk.com
# Allow unverified email for MVP Android testing.
# Mobile OAuth redirects use Expo scheme kangur:// (Clerk Dashboard).
# User identity SSoT: clerkId + primary email (invites use normalizeEmail equality).
# -----------------------------------------------------------------------------
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Comma-separated emails auto-promoted to platformRole=ADMIN on upsert (one-way).
# Never auto-demotes. Empty = no bootstrap. Per-environment (local / Preview / Production).
# PLATFORM_ADMIN_EMAILS=chris@example.com,ops@getkangur.com

# Emit metrics to console (backend). Default off - use InMemory + Noop only.
# METRICS_DEBUG=1

# Optional Clerk URLs if you customize paths
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# AI providers (orchestrator — OpenAI Responses + optional Gemini fallback)
# https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Used by production AI and offline evals: pnpm eval:ai --suite history-suggest

# Provider chain (comma-separated). Etap 1 default: openai only.
# Enable Gemini fallback later: AI_PROVIDER_CHAIN=openai,gemini
AI_PROVIDER_CHAIN=openai
# Default timeouts (ms). Clipboard/screenshot import-text/vision use a floor of
# 45s / 50s even if these are lower (large pastes need more headroom).
# AI_PRIMARY_TIMEOUT_MS=18000
# AI_FALLBACK_TIMEOUT_MS=20000
# AI_RETRY_MAX_PRIMARY_FAST=1

# Optional OpenAI model overrides (defaults live in code)
# OPENAI_MODEL_TEXT=
# OPENAI_MODEL_VISION=

# Gemini (optional — add keys before enabling in AI_PROVIDER_CHAIN)
# GEMINI_API_KEY=
# GEMINI_PROJECT_ID=gen-lang-client-0949047929
# GEMINI_MODEL_TEXT=gemini-2.0-flash
# GEMINI_MODEL_VISION=gemini-2.0-flash

# Free plan lifetime AI-use limit per workspace (integer). UX: "free AI uses".
# Legacy alias AI_FREE_MONTHLY_CREDITS still honored if LIFETIME unset.
AI_FREE_LIFETIME_CREDITS=15
# AI_FREE_MONTHLY_CREDITS=15

# History → AI list suggestions (backend SoT). Default on when unset.
# HISTORY_SUGGESTIONS_ENABLED=true|false

# -----------------------------------------------------------------------------
# PostHog (product analytics + feature flags) — M13.11
# No-op when POSTHOG_KEY unset. Dev off unless ANALYTICS_ENABLED=1.
# -----------------------------------------------------------------------------
# POSTHOG_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# ANALYTICS_ENABLED=0

# -----------------------------------------------------------------------------
# Sentry (API / server errors) — M13.11
# Off in development unless SENTRY_DEV=1.
# -----------------------------------------------------------------------------
# SENTRY_DSN=
# SENTRY_DEV=0

# -----------------------------------------------------------------------------
# Billing Platform (Web→Stripe; Android→Google Play; iOS→Apple stub)
# Stripe: workspace Premium via Checkout + Customer Portal + Invoices
# https://dashboard.stripe.com
# Local webhooks: stripe listen --forward-to localhost:3000/api/v1/billing/webhook
# Google RTDN: POST /api/v1/billing/webhook/google (Pub/Sub push)
# Apple ASN V2: POST /api/v1/billing/webhook/apple
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_PREMIUM=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Deep-link / web base after Checkout or Portal return (no trailing slash)
BILLING_RETURN_URL_BASE=kangur://premium

# Google Play Billing (Android Publisher API + RTDN)
# Package must match Play Console / EAS preview|production (app.kangur)
GOOGLE_PLAY_PACKAGE_NAME=app.kangur
# Service account JSON (raw) or base64-encoded JSON — Android Publisher scope
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# Email invitations (Resend)
# When unset, invites still work - accept URL is logged + returned for copy in UI.
# -----------------------------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=Kangur <onboarding@resend.dev>
# Deep-link / web base for invite accept links (no trailing slash)
INVITE_ACCEPT_URL_BASE=kangur://invite

# -----------------------------------------------------------------------------
# UploadThing (Feedback attachments only)
# Dashboard: https://uploadthing.com/dashboard — single token (v7+).
# Do not use UploadThing for other product media without an explicit decision.
# -----------------------------------------------------------------------------
# UPLOADTHING_TOKEN=

# -----------------------------------------------------------------------------
# Observability / misc (optional for MVP)
# -----------------------------------------------------------------------------
# LOG_LEVEL=info
# NODE_ENV=development
