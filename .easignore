# EAS archive ignore (git root). Replaces all .gitignore when present.
# Keep in sync with root + mobile .gitignore, plus EAS-only exclusions.

# --- from root .gitignore ---
node_modules/
.pnpm-store/

.env
.env.*
!.env.example
!backend/.env.example
!mobile/.env.example

backend/.next/
backend/out/

mobile/.expo/
mobile/dist/
mobile/web-build/

backend/prisma/*.db
backend/prisma/*.db-journal

.DS_Store
Thumbs.db
.idea/
*.swp
*.pem

npm-debug.*
yarn-debug.*
yarn-error.*
*.log

*.tsbuildinfo

coverage/

.vercel

# --- from mobile/.gitignore (paths relative to git root) ---
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/expo-env.d.ts
mobile/.kotlin/
mobile/*.orig.*
mobile/*.jks
mobile/*.p8
mobile/*.p12
mobile/*.key
mobile/*.mobileprovision
mobile/.metro-health-check*
mobile/.shared/
mobile/.env*.local
mobile/*.tsbuildinfo
mobile/ios/
mobile/android/
mobile/.tmp-*/
mobile/fcm-service-account*.json
mobile/*-firebase-adminsdk-*.json

# --- EAS Etap 1 hard exclusions ---
**/node_modules/
backend/node_modules/
backend/.next/
backend/out/

mobile/.tmp-*/
mobile/.tmp-aab-inspect/
mobile/.tmp-platform-tools/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/ios/
mobile/android/
mobile/.shared/
mobile/fcm-service-account*.json

docs/
.cursor/
.vercel/
.tmp-eas-archive-inspect/

**/.DS_Store
**/.idea/
**/.vscode/
